{
  "name": "claude-trader",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "dev:api": "node --env-file-if-exists=.env --experimental-strip-types --watch server/index.ts",
    "dev:all": "node scripts/dev-all.mjs",
    "build:server": "tsc -p tsconfig.server.json --noEmit",
    "db:migrate": "node --env-file-if-exists=.env --experimental-strip-types server/db/migrate.ts",
    "db:reset": "node --env-file-if-exists=.env --experimental-strip-types server/db/migrate.ts --reset",
    "start:api": "node --env-file-if-exists=.env --experimental-strip-types server/index.ts",
    "dev:lan": "CT_LAN=1 vite",
    "dev:all:lan": "CT_LAN=1 node scripts/dev-all.mjs"
  },
  "dependencies": {
    "express": "^5.1.0",
    "lightweight-charts": "^5.2.1",
    "pg": "^8.16.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.13",
    "@types/express": "^5.0.3",
    "@types/node": "^26.4.1",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.0",
    "tailwindcss": "^4.1.13",
    "typescript": "~5.9.3",
    "vite": "^8.0.0"
  }
}

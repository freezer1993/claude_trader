# Conexión a PostgreSQL. Ajusta usuario, contraseña, host y base.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/claude_trader

# Puerto del API.
PORT=3001

# Interfaz de escucha del API. Por defecto solo loopback: para ver la web desde
# el móvil NO hace falta cambiarlo, porque el navegador habla con Vite y es
# Vite quien reenvía al API por localhost. Ponerlo en 0.0.0.0 expone el API a
# toda la red y, sin login, cualquiera podría modificar tus saldos.
# API_HOST=127.0.0.1

# Orígenes permitidos por CORS, separados por comas.
CORS_ORIGINS=http://localhost:5173

# Propietario de los datos mientras no exista login. Debe existir en `users`.
LOCAL_USER_ID=00000000-0000-4000-8000-000000000001

# Versión del motor que se registra con cada análisis, para poder comparar
# recomendaciones sabiendo con qué criterio se generaron.
ENGINE_VERSION=macd-rsi-1.0.0
